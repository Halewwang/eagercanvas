{
  "name": "ai-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix backend run dev",
    "test:frontend": "find src -name '*.test.js' -not -name '* 2.js' -print0 | xargs -0 node --test",
    "lint": "eslint src --ext .js,.vue",
    "check:maintenance": "node scripts/check-maintenance.mjs",
    "check": "npm run lint && npm run check:maintenance && npm run test:frontend",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify-icons/ci": "^1.2.9",
    "@iconify/vue": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.1",
    "autoprefixer": "^10.4.23",
    "axios": "^1.13.2",
    "naive-ui": "^2.43.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "vite": "^5.2.0",
    "vue": "^3.5.24",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0"
  }
}
